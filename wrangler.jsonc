{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lightanime-api",
  "main": "index.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 4000
  },
  "vars": {
    "API_VERSION": "2.3",
    "CACHE_ENABLED": "false",
    "DEFAULT_REDIS_TTL": "900"
  }
  // Optional KV namespace binding for zero-latency edge caching:
  // "kv_namespaces": [
  //   {
  //     "binding": "CACHE_KV",
  //     "id": "<YOUR_KV_NAMESPACE_ID>"
  //   }
  // ]
}
